    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "^4.131.2"
  }
