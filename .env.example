# Optional. Defaults apply when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth: replace the public placeholder with a fresh random local secret.
# No fallback; public placeholders/fixture secrets are rejected on hosted origins.
BETTER_AUTH_SECRET=your_32_char_minimum_secret_key_here
BETTER_AUTH_URL=http://localhost:3000

# Local Admin Bootstrap Credentials (for development seed only)
ADMIN_INITIAL_EMAIL=admin@decodedhiring.local
ADMIN_INITIAL_PASSWORD=admin-local-dev-password-2026!
ADMIN_INITIAL_NAME=Decoded Editorial


# Admin 2FA (G3): enforced unless this is exactly "false". Local dev/CI only;
# production MUST leave it unset (enforced).
ADMIN_REQUIRE_2FA=false
