{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = LOCAL config: `next dev`, tests, `db:migrate:local` (via
  // getPlatformProxy) and the base for wrangler.preview.jsonc.
  // Resource IDs here are never used remotely.
  // No WORKER_SELF_REFERENCE or internal DO binding here: getPlatformProxy
  // has no running Worker/DO implementation (Next dev/build only needs D1/R2).
  // Preview and Worker E2E use wrangler.preview.jsonc with BOTH bindings;
  // production repeats them below. DO migrations also stay out of this proxy
  // config: Wrangler emulates migrated classes even without a binding.
  "name": "decoded-hiring-v2",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decoded-hiring-local-db",
      "database_id": "local-db-placeholder",
      "migrations_dir": "drizzle/migrations"
    },
    {
      // Same D1 as DB. OpenNext populateCache creates its revalidations table.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "decoded-hiring-local-db",
      "database_id": "local-db-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "decoded-hiring-local-media"
    },
    {
      // OpenNext R2 incremental cache (ISR / revalidatePath).
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "decoded-hiring-local-next-cache"
    }
  ],

  // PRODUCTION — not provisioned yet. Before the first deploy, replace every
  // <PLACEHOLDER> with real resources (see Docs/Engineering/DEPLOYMENT.md).
  // Bindings are not inherited by environments, so all of them are repeated.
  "env": {
    "production": {
      "name": "decoded-hiring-v2",
      "migrations": [
        { "tag": "isr-queue-v1", "new_sqlite_classes": ["DOQueueHandler"] }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "decoded-hiring-v2"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "<PROD_D1_DATABASE_NAME>",
          "database_id": "<PROD_D1_DATABASE_ID>",
          "migrations_dir": "drizzle/migrations"
        },
        {
          // Must match DB above; no separate database is needed.
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "<PROD_D1_DATABASE_NAME>",
          "database_id": "<PROD_D1_DATABASE_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "<PROD_MEDIA_BUCKET_NAME>"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "<PROD_NEXT_CACHE_BUCKET_NAME>"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "<PROD_SITE_URL>",
        "NEXT_PUBLIC_SITE_URL": "<PROD_SITE_URL>"
      }
    }
  }
}
