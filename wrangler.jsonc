{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = LOCAL config: `next dev`, tests, `db:migrate:local` (via
  // getPlatformProxy) and the base for wrangler.preview.jsonc.
  // Resource IDs here are never used remotely.
  // No WORKER_SELF_REFERENCE here on purpose: getPlatformProxy has no running
  // worker to resolve it, and on Linux workerd logs "Failed to get handler to
  // worker" (CI e2e noise). `npm run preview` uses wrangler.preview.jsonc,
  // which adds the binding; production gets it from env.production below.
  "name": "decoded-hiring-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decoded-hiring-local-db",
      "database_id": "local-db-placeholder",
      "migrations_dir": "drizzle/migrations"
    },
    {
      // Same D1 as DB. OpenNext populateCache creates its revalidations table.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "decoded-hiring-local-db",
      "database_id": "local-db-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "decoded-hiring-local-media"
    },
    {
      // OpenNext R2 incremental cache (ISR / revalidatePath).
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "decoded-hiring-local-next-cache"
    }
  ],

  // PRODUCTION — not provisioned yet. Before the first deploy, replace every
  // <PLACEHOLDER> with real resources (see Docs/Engineering/DEPLOYMENT.md).
  // Bindings are not inherited by environments, so all of them are repeated.
  "env": {
    // Disposable TEST environment only. IDs/names select resources, not credentials.
    // The ISR queue branch adds its Durable Object binding/migration on merge.
    "cputest": {
      "name": "dh-cputest",
      "workers_dev": true,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "dh-cputest" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dh-cputest-db",
          "database_id": "48a2e827-8d37-4041-a311-4642aa5a2d76",
          "migrations_dir": "drizzle/migrations"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "dh-cputest-db",
          "database_id": "48a2e827-8d37-4041-a311-4642aa5a2d76"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA_BUCKET", "bucket_name": "dh-cputest-media" },
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "dh-cputest-next-cache" }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://dh-cputest.hdv2.workers.dev",
        "NEXT_PUBLIC_SITE_URL": "https://dh-cputest.hdv2.workers.dev"
      }
    },
    "production": {
      "name": "decoded-hiring-v2",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "decoded-hiring-v2"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "<PROD_D1_DATABASE_NAME>",
          "database_id": "<PROD_D1_DATABASE_ID>",
          "migrations_dir": "drizzle/migrations"
        },
        {
          // Must match DB above; no separate database is needed.
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "<PROD_D1_DATABASE_NAME>",
          "database_id": "<PROD_D1_DATABASE_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "<PROD_MEDIA_BUCKET_NAME>"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "<PROD_NEXT_CACHE_BUCKET_NAME>"
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "<PROD_SITE_URL>",
        "NEXT_PUBLIC_SITE_URL": "<PROD_SITE_URL>"
      }
    }
  }
}
